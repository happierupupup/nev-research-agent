# OpenAI-compatible API (official OpenAI or DashScope / other gateways)
OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embeddings for KB ingest/search
# OpenAI: text-embedding-3-small
# DashScope: text-embedding-v3 / qwen3.7-text-embedding（换模型须重建索引，见 failure-log F1/F2）
EMBEDDING_MODEL=text-embedding-v3

# 知识库检索后端：json（默认，本地余弦）| milvus（Milvus Lite 文件库，无 Docker）
# KB_BACKEND=json
# KB_BACKEND=milvus
# MILVUS_URI=   # 默认 data/milvus/nev.db；也可写绝对路径
# MILVUS_ALSO_INGEST=true  # 即使 KB_BACKEND=json，ingest 时也顺便写 Lite

# 测试用户：admin（管理员）| alice（普通用户）；见 config/users.yaml
# NEV_USER_ID=alice

# Web search (optional). If empty, DuckDuckGo is used.
# TAVILY_API_KEY=

# Agent mode: s2 (default multi-agent) or s1 (single ReAct)
# AGENT_MODE=s2

# Agent loop
# AGENT_RECURSION_LIMIT=25

# Observability (optional, later)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

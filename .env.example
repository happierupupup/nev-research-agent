# OpenAI-compatible API (official OpenAI or DashScope / other gateways)
OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embeddings for KB ingest/search
# OpenAI: text-embedding-3-small
# DashScope: text-embedding-v3 / qwen3.7-text-embedding（换模型须重建索引，见 failure-log F1/F2）
EMBEDDING_MODEL=text-embedding-v3

# 知识库检索后端：json（默认，本地余弦）| milvus（Milvus Lite 文件库，无 Docker）
# KB_BACKEND=json
# KB_BACKEND=milvus

# RAG 查询改写：rules（默认，规则）| llm（小模型改写，失败回退 rules）| off
# KB_QUERY_REWRITE=rules
# 检索模式：vector（默认）| keyword | hybrid
# KB_RETRIEVAL_MODE=vector
# 重排：off（默认）| lexical | gte（DashScope gte-rerank-v2）
# KB_RERANK=off
# KB_RERANK_CANDIDATES=32
# KB_RERANK_MODEL=gte-rerank-v2
# MILVUS_URI=   # 默认 data/milvus/nev.db；也可写绝对路径
# MILVUS_ALSO_INGEST=true  # 即使 KB_BACKEND=json，ingest 时也顺便写 Lite

# 测试用户：admin（管理员）| alice（普通用户）；见 config/users.yaml
# NEV_USER_ID=alice

# Gradio Web（python web_app.py）
# NEV_WEB_HOST=127.0.0.1
# NEV_WEB_PORT=7860
# NEV_WEB_RELOAD=false

# Web search (optional). If empty, DuckDuckGo is used.
# TAVILY_API_KEY=

# Tool-result cache (optional Redis). Fail-open if unset / unreachable.
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_KB_TTL=21600          # ordinary KB 6h
# CACHE_WEB_TTL=1800          # ordinary Web 30min
# CACHE_KB_HOT_TTL=86400      # hot KB 24h
# CACHE_WEB_HOT_TTL=7200      # hot Web 2h
# CACHE_HOT_THRESHOLD=3       # ≥3 hits in 24h → hot TTL

# Agent mode: s2 (default multi-agent) or s1 (single ReAct)
# AGENT_MODE=s2

# Agent loop
# AGENT_RECURSION_LIMIT=25

# Observability (optional, later)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

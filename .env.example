# OpenAI-compatible API (official OpenAI or DashScope / other gateways)
OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embeddings for KB ingest/search
# OpenAI: text-embedding-3-small
# DashScope: text-embedding-v3（且勿依赖默认 tiktoken 切分，见 docs/failure-log.md F1）
EMBEDDING_MODEL=text-embedding-3-small

# Observability (optional, later)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
